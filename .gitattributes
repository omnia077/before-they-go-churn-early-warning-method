# Normalise line endings so Windows and Linux checkouts diff cleanly
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.ipynb text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
# binaries
*.png binary
*.pptx binary
*.parquet binary
*.duckdb binary
